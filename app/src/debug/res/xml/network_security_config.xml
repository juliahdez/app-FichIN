<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>

    <domain-config>
        <domain includeSubdomains="true">192.168.1.96</domain>
        <pin-set expiration="2026-12-31">
            <pin digest="SHA-256">jXz6FkJQXyhvjS08sPAv+rEW7/lelZ3pb1OSbH2bvnE=</pin>
            <pin digest="SHA-256">rxF9dOOjCyJ+e8FsyfqUh+vWVRzpiN8B9PX0t4Wcg6g=</pin>
        </pin-set>
    </domain-config>

    <!-- SOLO depuración: CA del laboratorio y almacén del usuario -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="@raw/cert_laboratorio" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>